{
  "name": "intelligent-expense-budget-system-datasets",
  "version": "1.0.0",
  "description": "Comprehensive hardcoded datasets and Firebase Firestore upload utilities for Intelligent Expense Approval and Budget Monitoring System",
  "main": "scripts/upload_to_firebase.js",
  "type": "module",
  "scripts": {
    "server": "node server/server.js",
    "client": "vite",
    "dev": "concurrently -k \"node server/server.js\" \"vite\"",
    "build": "vite build",
    "preview": "vite preview",
    "validate": "node scripts/validate_datasets.js",
    "upload": "node scripts/upload_to_firebase.js",
    "upload:dry": "node scripts/upload_to_firebase.js --dry-run",
    "upload:supabase": "node scripts/upload_to_supabase.js",
    "upload:supabase:dry": "node scripts/upload_to_supabase.js --dry-run",
    "test:supabase": "node scripts/test_connection.js"
  },
  "keywords": [
    "expense-approval",
    "budget-monitoring",
    "firebase",
    "firestore",
    "datasets",
    "seed-data"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "firebase-admin": "^12.0.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.1"
  }
}
